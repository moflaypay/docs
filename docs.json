{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Moflay Documentation",
  "description": "Developer documentation for integrating M-Pesa payments with Moflay. Learn account setup, API keys, sandbox and production credentials, webhooks, SDK usage, and the Moflay API.",
  "theme": "aspen",
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#00c062",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "contextual": {
    "display": "toc",
    "options": ["copy", "mcp", "chatgpt", "claude", "cursor", "vscode"]
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "logo": {
    "light": "/logo/moflay-black-logo.svg",
    "dark": "/logo/moflay-white-logo.svg"
  },
  "navbar": {
    "primary": {
      "href": "https://app.moflay.com",
      "label": "Dashboard",
      "type": "button"
    },
    "links": [
      {
        "label": "Contact Support",
        "href": "mailto:support@moflay.com"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/moflaypay",
      "github": "https://github.com/moflaypay",
      "linkedin": "https://www.linkedin.com/company/moflaypay",
      "website": "https://moflay.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Developer Docs",
        "icon": "books",
        "groups": [
          {
            "group": "GET STARTED",
            "pages": [
              "introduction",
              "first-payment",
              "first-payment-http",
              "setup-moflay",
              "setup-api-key",
              "how-moflay-works",
              "sdk"
            ]
          },
          {
            "group": "PAYMENTS",
            "pages": ["payments/transaction-statuses"]
          },
          {
            "group": "DASHBOARD",
            "pages": [
              "dashboard/environments",
              "dashboard/credentials",
              "dashboard/credentials-security",
              "dashboard/api-keys/introduction"
            ]
          },
          {
            "group": "DARAJA & M-PESA",
            "pages": [
              "daraja/setup-sandbox-credentials",
              "daraja/setup-production-credentials",
              "daraja/handling-callbacks"
            ]
          },
          {
            "group": "WEBHOOKS",
            "pages": [
              "webhooks/overview",
              "webhooks/signature-verification",
              "webhooks/events",
              "webhooks/retries-and-idempotency"
            ]
          },
          {
            "group": "GO LIVE",
            "pages": ["go-live/checklist"]
          },
          {
            "group": "EXAMPLES",
            "pages": [
              "sdk-examples/express-payment",
              "sdk-examples/customer-management",
              "sdk-examples/transaction-management"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "CORE CONCEPTS",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors",
              "api-reference/rate-limit",
              "api-reference/pagination"
            ]
          },
          {
            "group": "APIS",
            "expanded": true,
            "openapi": {
              "source": "https://api.moflay.com/openapi",
              "directory": "api-reference"
            }
          }
        ]
      }
    ]
  }
}
